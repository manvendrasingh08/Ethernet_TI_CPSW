//called in the interrupt context when the packet has received.
static void cpsw_rx_handler(void *token, int len, int status)  //parametrs are passsed on by the ethernet ports
{
	struct page		*new_page, *page = token; //page is the where the recived packet is stored.
	void			*pa = page_address(page); //page_address is mapping the physical addr of page to the vitual addr 
	struct cpsw_meta_xdp	*xmeta = pa + CPSW_XMETA_OFFSET; // moving the pointer to point the metadata so can directly access it.
	struct cpsw_common	*cpsw = ndev_to_cpsw(xmeta->ndev); //converting the ndev struct to cpsw struct.
	int			pkt_size = cpsw->rx_packet_max;
	int			ret = 0, port, ch = xmeta->ch;
	int			headroom = CPSW_HEADROOM; //The headroom can store data for the processing stages, such as queuing information, timestamps, or pointers to other buffers.
	struct net_device	*ndev = xmeta->ndev;
	struct cpsw_priv	*priv;
	struct page_pool	*pool;
	struct sk_buff		*skb;
	struct xdp_buff		xdp;
	dma_addr_t		dma;


	if (cpsw->data.dual_emac && status >= 0) { 
		port = CPDMA_RX_SOURCE_PORT(status);
		if (port)
			ndev = cpsw->slaves[--port].ndev;
	}
/*
If cpsw->data.dual_emac is true, here are multiple Ethernet interfaces (slaves) handled by the same CPSW driver.

 status >= 0: This checks if the reception status is valid. The status indicates whether the packet was received successfully.

CPDMA_RX_SOURCE_PORT(status): This macro extracts the source port information from the status (i.e., which slave port the packet was received on)

*/


	priv = netdev_priv(ndev);
	pool = cpsw->page_pool[ch]; // page pool associated with the specific DMA channel ->ch
	if (unlikely(status < 0) || unlikely(!netif_running(ndev))) {
		/* In dual emac mode check for all interfaces */
		if (cpsw->data.dual_emac && cpsw->usage_count &&
		    (status >= 0)) {
			/* The packet received is for the interface which
			 * is already down and the other interface is up
			 * and running, instead of freeing which results
			 * in reducing of the number of rx descriptor in
			 * DMA engine, requeue page back to cpdma.
			 */
			new_page = page;
			goto requeue;
		}

		/* the interface is going down, pages are purged */
		page_pool_recycle_direct(pool, page);
		return;
	}

	new_page = page_pool_dev_alloc_pages(pool); // This allocates a new page from the page pool for receiving the next packet.
	if (unlikely(!new_page)) {
		new_page = page;
		ndev->stats.rx_dropped++;
		goto requeue;
	}

	if (priv->xdp_prog) {  //check id XDP is enabled.
		if (status & CPDMA_RX_VLAN_ENCAP) { //checks if the received packet has VLAN encapsulation
			xdp.data = pa + CPSW_HEADROOM + CPSW_RX_VLAN_ENCAP_HDR_SIZE; //If VLAN encapsulation is present, xdp.data is adjusted to account for the VLAN header, which is placed after the Ethernet header.
			xdp.data_end = xdp.data + len -
				       CPSW_RX_VLAN_ENCAP_HDR_SIZE;
		} else {      // If there is no VLAN encapsulation, xdp.data is simply set to the packet data after the headroom (CPSW_HEADROOM), and xdp.data_end is set to the end of the packet (len).
			xdp.data = pa + CPSW_HEADROOM;
			xdp.data_end = xdp.data + len;
		}

		xdp_set_data_meta_invalid(&xdp);  //invalidates the metadata, so that once invoked it dopeas not use stale metatda

		xdp.data_hard_start = pa;
		xdp.rxq = &priv->xdp_rxq[ch];
		xdp.frame_sz = PAGE_SIZE;

		port = priv->emac_port + cpsw->data.dual_emac; // tells the port number.
		ret = cpsw_run_xdp(priv, ch, &xdp, page, port, &len); // it process the xdp packet and returns CPSW_XDP_PASS on success.
		if (ret != CPSW_XDP_PASS)  
			goto requeue;   // if failed goto requeue.

		headroom = xdp.data - xdp.data_hard_start;

		/* XDP prog can modify vlan tag, so can't use encap header */
		status &= ~CPDMA_RX_VLAN_ENCAP;
	}

	/* pass skb to netstack if no XDP prog or returned XDP_PASS */
	skb = build_skb(pa, cpsw_rxbuf_total_len(pkt_size));
	if (!skb) {
		ndev->stats.rx_dropped++;
		page_pool_recycle_direct(pool, page);
		goto requeue;
	}

	skb_reserve(skb, headroom);   // reserve the headroom size for the metadata like timestamp, different flags, TCP segmentatin etc..
	skb_put(skb, len);  // putting teh packet data in the skb.
	skb->dev = ndev;
	if (status & CPDMA_RX_VLAN_ENCAP)
		cpsw_rx_vlan_encap(skb);
	if (priv->rx_ts_enabled)    //checking if the timestamp is enabled.
		cpts_rx_timestamp(cpsw->cpts, skb);
	skb->protocol = eth_type_trans(skb, ndev);  // checking the eth_type in the ethernet header for layer3 protocol IPv4, Ipv6 or ARP.

	/* unmap page as no netstack skb page recycling */
	page_pool_release_page(pool, page);
	netif_receive_skb(skb);   // *** This sends the skb into the network stack ***

	ndev->stats.rx_bytes += len;
	ndev->stats.rx_packets++;  //increasing the number of rx_packets can be seen using ethtool -S eth0

requeue:
	xmeta = page_address(new_page) + CPSW_XMETA_OFFSET;
	xmeta->ndev = ndev;
	xmeta->ch = ch;

	dma = page_pool_get_dma_addr(new_page) + CPSW_HEADROOM;
	ret = cpdma_chan_submit_mapped(cpsw->rxv[ch].ch, new_page, dma,pkt_size, 0); //It submits the page as a new RX descriptor into the RX DMA ring.
	if (ret < 0) {
		WARN_ON(ret == -ENOMEM);
		page_pool_recycle_direct(pool, new_page);
	}
}



   


