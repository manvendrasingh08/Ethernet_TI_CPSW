xmeta->ndev = ndev;
xmeta->ch = ch;

- Setup metadata for next DMA RX operation.

dma = page_pool_get_dma_addr(new_page) + CPSW_HEADROOM;

- Get DMA physical address (already mapped)
- Add headroom so DMA writes data after metadata.

